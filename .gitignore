# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite temporary files
*.db-wal
*.db-shm
*.db-journal

# desktop build outputs
/dist-desktop/
/offline/windows/Sastmhaly-POS-Setup.exe
*.log
offline/windows/node.exe
sastmhaly-merchant-windows/node.exe
sastmhaly-merchant-windows/node_modules/
sastmhaly-merchant-windows/data/
sastmhaly-merchant-windows/*.db*
sastmhaly-merchant-windows/Sastmhaly-Store-Setup.exe
